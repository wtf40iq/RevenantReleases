<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="using:RevenantLauncher.Behaviors">

    <Styles.Resources>
        <!-- Шаблон кнопок с настоящим жидким стеклом: под кнопкой рисуется
             размытый срез баннера (LiquidGlassLayer), поверх — стеклянная тонировка -->
        <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
            <Panel>
                <behaviors:LiquidGlassLayer CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Panel>
        </ControlTemplate>
    </Styles.Resources>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ScrollBar -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#60FFFFFF"/>
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="ScrollBar:horizontal:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#60FFFFFF"/>
    </Style>

    <!-- Nav button base -->
    <Style Selector="Button.navBtn">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#30FFFFFF"/>
    </Style>

    <Style Selector="Button.navBtnActive">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NavActiveBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.navBtnActive /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavActiveBackground}"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <!-- Top bar button -->
    <Style Selector="Button.topBarBtn">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.topBarBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55000000"/>
    </Style>

    <!-- Play button -->
    <Style Selector="Button.playBtn">
        <Setter Property="Height" Value="50"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Padding" Value="32,0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.playBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="25"/>
    </Style>

    <!-- BIG play button -->
    <Style Selector="Button.playBtnBig">
        <Setter Property="Height" Value="60"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Padding" Value="40,0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.playBtnBig /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Settings gear -->
    <Style Selector="Button.settingsGearBtn">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource RoundButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.settingsGearBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="30"/>
    </Style>
    <Style Selector="Button.settingsGearBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55FFFFFF"/>
    </Style>

    <!-- Installed badge -->
    <Style Selector="Border.installedBadge">
        <Setter Property="Background" Value="#3066BB6A"/>
        <Setter Property="BorderBrush" Value="#5066BB6A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <!-- Settings button -->
    <Style Selector="Button.settingsBtn">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource RoundButtonBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.settingsBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55FFFFFF"/>
    </Style>

    <!-- Window control buttons -->
    <Style Selector="Button.winBtn">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.winBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#60000000"/>
    </Style>

    <Style Selector="Button.winBtnClose">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.winBtnClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#CCFF4444"/>
    </Style>

    <!-- Account panel -->
    <Style Selector="Border.accountPanel">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Button.accountItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.accountItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#30FFFFFF"/>
    </Style>

    <Style Selector="Button.accountItemSelected">
        <Setter Property="Background" Value="{DynamicResource AccountSelectedBackground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Button.addAccountBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.addAccountBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#20FFFFFF"/>
    </Style>

    <!-- Quick launch panel -->
    <Style Selector="Border.quickLaunch">
        <Setter Property="Background" Value="{DynamicResource QuickLaunchBackground}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <!-- Карточка аккаунта Revenant: ховер подсвечивает всю карточку -->
    <Style Selector="Border.accountChipCard">
        <Setter Property="Background" Value="{DynamicResource QuickLaunchBackground}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.accountChipCard:pointerover">
        <Setter Property="Background" Value="#3AFFFFFF"/>
    </Style>

    <!-- Внутренняя кнопка чипа без собственного ховера -->
    <Style Selector="Button.accountChipBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.accountChipBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Button.accountChipBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#10FFFFFF"/>
    </Style>

    <!-- Small play button -->
    <Style Selector="Button.smallPlayBtn">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.smallPlayBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <!-- ProgressBar -->
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Version dialog tabs -->
    <Style Selector="Button.tab">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource TabBackground}"/>
        <Setter Property="Foreground" Value="#B0B0B0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#50FFFFFF"/>
    </Style>

    <Style Selector="Button.tabActive">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource TabActiveBackground}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tabActive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TabActiveHoverBackground}"/>
    </Style>

    <!-- Version item in list -->
    <Style Selector="Button.versionItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.versionItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#25FFFFFF"/>
    </Style>

    <!-- CheckBox (purple) -->
    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#9E7BFF"/>
        <Setter Property="Background" Value="#207C4DFF"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#7C4DFF"/>
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#8B5CFF"/>
        <Setter Property="BorderBrush" Value="#8B5CFF"/>
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="White"/>
    </Style>

    <!-- TextBox (purple focus) -->
    <Style Selector="TextBox">
        <Setter Property="CaretBrush" Value="#B388FF"/>
        <Setter Property="SelectionBrush" Value="#7C4DFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Search box -->
    <Style Selector="Border.searchBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style Selector="Border.searchBox:focus-within">
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
        <Setter Property="Background" Value="#20000000"/>
    </Style>

    <!-- Delete account button -->
    <Style Selector="Button.deleteAccountBtn">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="Button.deleteAccountBtn:pointerover">
        <Setter Property="Foreground" Value="#FF6666"/>
    </Style>

    <Style Selector="Button.deleteAccountBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#40FF4444"/>
    </Style>

    <Style Selector="Button.accountItem:pointerover Button.deleteAccountBtn,
                     Button.accountItemSelected:pointerover Button.deleteAccountBtn">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Friend card (страница «Друзья») -->
    <Style Selector="Border.friendCard">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.friendCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardHoverBackground}"/>
        <Setter Property="BorderBrush" Value="#607C4DFF"/>
    </Style>

    <!-- Кнопка удаления друга — всегда видна -->
    <Style Selector="Button.friendDeleteBtn">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.friendDeleteBtn:pointerover">
        <Setter Property="Foreground" Value="#FF6B6B"/>
        <Setter Property="RenderTransform" Value="scale(1.12)"/>
    </Style>

    <Style Selector="Button.friendDeleteBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#30FF4444"/>
    </Style>

    <!-- Кнопка обновления списка друзей -->
    <Style Selector="Button.refreshBtn">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#B388FF"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.refreshBtn:pointerover">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="RenderTransform" Value="rotate(180deg) scale(1.1)"/>
    </Style>

    <Style Selector="Button.refreshBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#25FFFFFF"/>
    </Style>

    <!-- Кнопка чата в карточке друга -->
    <Style Selector="Button.chatBtn">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="#B388FF"/>
    </Style>
    <Style Selector="Button.chatBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#302F1B58"/>
    </Style>
    <Style Selector="Button.chatBtn:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Компактные кнопки заявок в друзья -->
    <Style Selector="Button.smallAcceptBtn">
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="#66BB6A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.smallAcceptBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    <Style Selector="Button.smallAcceptBtn:pointerover">
        <Setter Property="Background" Value="#43A047"/>
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>

    <Style Selector="Button.smallDeclineBtn">
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Background" Value="#25FFFFFF"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.smallDeclineBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="15"/>
    </Style>
    <Style Selector="Button.smallDeclineBtn:pointerover">
        <Setter Property="Background" Value="#40FF4444"/>
        <Setter Property="BorderBrush" Value="#66FF4444"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>

    <!-- Settings section card -->
    <Style Selector="Border.settingsSection">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource SectionCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Slider (purple) -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="#7C4DFF"/>
    </Style>
    <Style Selector="Slider /template/ Track#PART_Track /template/ Thumb">
        <Setter Property="Background" Value="#B388FF"/>
    </Style>
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="#7C4DFF"/>
    </Style>
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#30FFFFFF"/>
    </Style>

    <!-- ToggleSwitch (purple) -->
    <Style Selector="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource InterFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="#7C4DFF"/>
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
    </Style>

    <!-- Mod card -->
    <Style Selector="Border.modCard">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Border.modCard:pointerover">
        <Setter Property="BorderBrush" Value="#607C4DFF"/>
    </Style>

    <!-- Icon button -->
    <Style Selector="Button.iconBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#40FF4444"/>
    </Style>

    <!-- Clickable mod card in browse -->
    <Style Selector="Border.modCardClickable">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Version card in details dialog -->
    <Style Selector="Button.versionCard">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.versionCard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBackground}"/>
    </Style>

    <Style Selector="Button.versionCardSelected">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource VersionSelectedBackground}"/>
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.versionCardSelected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBackground}"/>
    </Style>

    <!-- Link buttons -->
    <Style Selector="Button.linkBtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.linkBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#20FFFFFF"/>
    </Style>

    <!-- Toast close button -->
    <Style Selector="Button.toastClose">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.toastClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#30FFFFFF"/>
    </Style>

    <!-- Dep version button -->
    <Style Selector="Button.depVersionBtn">
        <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="#25FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.depVersionBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardHoverBackground}"/>
    </Style>

    <!-- Stat card in history -->
    <Style Selector="Border.statCard">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="MinHeight" Value="80"/>
    </Style>

    <!-- Session card -->
    <Style Selector="Border.sessionCard">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style Selector="Button.sessionHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.sessionHeader:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ===== СОВРЕМЕННЫЕ АНИМАЦИИ ===== -->

    <!-- Плавная анимация фона для всех кнопок при наведении -->
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Play button + BIG play button -->
    <Style Selector="Button.playBtn, Button.playBtnBig">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.playBtn:pointerover, Button.playBtnBig:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.05)"/>
    </Style>

    <Style Selector="Button.playBtn:pressed, Button.playBtnBig:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Settings button -->
    <Style Selector="Button.settingsBtn">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.settingsBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <Style Selector="Button.settingsBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Settings gear - вращение при наведении -->
    <Style Selector="Button.settingsGearBtn">
        <Setter Property="RenderTransform" Value="rotate(0deg) scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.settingsGearBtn:pointerover">
        <Setter Property="RenderTransform" Value="rotate(90deg) scale(1.05)"/>
    </Style>

    <Style Selector="Button.settingsGearBtn:pressed">
        <Setter Property="RenderTransform" Value="rotate(90deg) scale(0.95)"/>
    </Style>

    <!-- Small play button -->
    <Style Selector="Button.smallPlayBtn">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.smallPlayBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.12)"/>
    </Style>

    <Style Selector="Button.smallPlayBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>

    <!-- Nav buttons -->
    <Style Selector="Button.navBtn, Button.navBtnActive">
        <Setter Property="RenderTransform" Value="translateY(0px) scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.navBtn:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-3px) scale(1.05)"/>
    </Style>

    <Style Selector="Button.navBtn:pressed">
        <Setter Property="RenderTransform" Value="translateY(0px) scale(0.95)"/>
    </Style>

    <Style Selector="Button.navBtnActive:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-2px) scale(1.03)"/>
    </Style>

    <!-- Top bar buttons -->
    <Style Selector="Button.topBarBtn">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.topBarBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <Style Selector="Button.topBarBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Window buttons -->
    <Style Selector="Button.winBtn, Button.winBtnClose">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.winBtn:pointerover, Button.winBtnClose:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.08)"/>
    </Style>

    <Style Selector="Button.winBtn:pressed, Button.winBtnClose:pressed">
        <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>

    <!-- Cards анимация -->
<Style Selector="Border.modCard">
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        </Transitions>
    </Setter>
</Style>

    <Style Selector="Border.modCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardHoverBackground}"/>
        <Setter Property="BorderBrush" Value="#607C4DFF"/>
    </Style>

    <Style Selector="Border.sessionCard">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.sessionCard:pointerover">
        <Setter Property="BorderBrush" Value="#507C4DFF"/>
    </Style>

    <!-- Stat cards -->
    <Style Selector="Border.statCard">
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.statCard:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-3px)"/>
        <Setter Property="BorderBrush" Value="#507C4DFF"/>
    </Style>

    <!-- Account items -->
    <Style Selector="Button.accountItem, Button.accountItemSelected">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.accountItem:pressed, Button.accountItemSelected:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Tabs -->
    <Style Selector="Button.tab, Button.tabActive">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.tab:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>

    <Style Selector="Button.tab:pressed, Button.tabActive:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Version cards -->
    <Style Selector="Button.versionCard, Button.versionCardSelected">
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.versionCard:pointerover">
        <Setter Property="RenderTransform" Value="translateX(4px)"/>
    </Style>

    <!-- Version item -->
    <Style Selector="Button.versionItem">
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.versionItem:pointerover">
        <Setter Property="RenderTransform" Value="translateX(4px)"/>
    </Style>

    <!-- Icon buttons -->
    <Style Selector="Button.iconBtn">
        <Setter Property="RenderTransform" Value="scale(1) rotate(0deg)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.iconBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.15) rotate(8deg)"/>
    </Style>

    <Style Selector="Button.iconBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.9) rotate(0deg)"/>
    </Style>

    <!-- Toast close -->
    <Style Selector="Button.toastClose">
        <Setter Property="RenderTransform" Value="scale(1) rotate(0deg)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.toastClose:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.1) rotate(90deg)"/>
    </Style>

    <!-- Link buttons -->
    <Style Selector="Button.linkBtn">
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.linkBtn:pointerover">
        <Setter Property="RenderTransform" Value="translateX(3px)"/>
    </Style>

    <!-- Add account button -->
    <Style Selector="Button.addAccountBtn">
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.addAccountBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
    </Style>

    <Style Selector="Button.addAccountBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Page transitions -->
    <Style Selector="Panel > Grid.pageContent,
                     Panel > ContentControl.pageContent">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- ToggleSwitch анимация -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ToggleSwitch:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>

    <!-- CheckBox анимация -->
    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="CheckBox:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>

    <!-- Search box анимация -->
    <Style Selector="Border.searchBox">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Delete account button -->
    <Style Selector="Button.deleteAccountBtn">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
        <Setter Property="RenderTransform" Value="scale(1)"/>
    </Style>

    <Style Selector="Button.deleteAccountBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.15)"/>
    </Style>

    <!-- ===== АНИМАЦИИ ПОЯВЛЕНИЯ ===== -->

    <!-- Плавное появление страниц (fade + slide справа) -->
    <Style Selector="Panel > Grid.pageContent,
                     Panel > ContentControl.pageContent">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- При появлении страницы (IsVisible=true) — из позиции translateX(30) в translateX(0) -->
    <Style Selector="Panel > Grid.pageContent[IsVisible=false],
                     Panel > ContentControl.pageContent[IsVisible=false]">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateX(30px)"/>
    </Style>

    <Style Selector="Panel > Grid.pageContent[IsVisible=true],
                     Panel > ContentControl.pageContent[IsVisible=true]">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
    </Style>

    <!-- Анимация диалогов (Border с классом dialogBox) -->
    <Style Selector="ContentControl">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Панель аккаунтов — slide-in справа -->
    <Style Selector="Border.accountPanel">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.accountPanel[IsVisible=false]">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translateX(50px)"/>
    </Style>

    <Style Selector="Border.accountPanel[IsVisible=true]">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="translateX(0px)"/>
    </Style>

        <!-- Wrapper для диалогов - плавное появление -->
    <!-- Диалоги появляются мгновенно: затемнение без анимации -->
    <Style Selector="ContentControl.dialogWrapper[IsVisible=false]">
        <Setter Property="Opacity" Value="0"/>
    </Style>

    <Style Selector="ContentControl.dialogWrapper[IsVisible=true]">
        <Setter Property="Opacity" Value="1"/>
    </Style>

</Styles>