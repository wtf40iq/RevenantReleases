<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RevenantLauncher.Views.UpdateWindow"
        Width="560" Height="430"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False">
    <Border CornerRadius="20" Margin="18" ClipToBounds="True"
            Background="#171026" BorderBrush="#40FFFFFF" BorderThickness="1"
            BoxShadow="0 8 28 0 #CC000000">
        <Grid RowDefinitions="Auto,*,Auto" Margin="30,26,30,26">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Доступно обновление" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Revenant Launcher" FontSize="13" Foreground="#AFA5C8"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#307C4DFF" CornerRadius="16" Padding="12,7">
                    <TextBlock x:Name="VersionText" FontSize="14" FontWeight="SemiBold" Foreground="#D8C9FF"/>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
                <Border Background="#18FFFFFF" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Что нового" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" Foreground="#C8C0D8"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Text="Обновление скачает установщик и сохранит твои настройки."
                           TextWrapping="Wrap" FontSize="12" Foreground="#AFA5C8"/>
                <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="7"
                             IsVisible="False" Foreground="#7C4DFF" Background="#30FFFFFF"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="LaterButton" Content="Позже" Click="Later_Click"
                        Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                        Padding="22,10" CornerRadius="10" Foreground="#DDDDDD"/>
                <Button x:Name="UpdateButton" Click="Update_Click" Padding="22,10"
                        Background="#7C4DFF" BorderThickness="0" CornerRadius="10">
                    <TextBlock Text="Обновить сейчас" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
