<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncher.ViewModels"
             xmlns:models="using:RevenantLauncher.Models"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:behaviors="using:RevenantLauncher.Behaviors"
             x:Class="RevenantLauncher.Views.DependencyDialog"
             x:DataType="vm:DependencyDialogViewModel">

    <Border Background="#B0000000" ClipToBounds="True">
        <Border Background="{DynamicResource DialogBackground}"
                CornerRadius="{DynamicResource SectionCornerRadius}"
                BorderBrush="{DynamicResource DialogBorderBrush}"
                BorderThickness="1"
                Width="680" MaxHeight="740"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 20 60 0 #80000000">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <Border Width="56" Height="56" CornerRadius="12" Background="#2A1F3F" ClipToBounds="True">
                        <Panel>
                            <PathIcon Data="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"
                                      Foreground="#B388FF" Width="24" Height="24"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image asyncImageLoader:ImageLoader.Source="{Binding MainIconUrl}" Stretch="UniformToFill"
                                   behaviors:IconPlaceholderBehavior.IsEnabled="True"/>
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Установка мода" FontSize="12" Foreground="#888888"/>
                        <TextBlock Text="{Binding MainTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding MainVersion, StringFormat='Версия {0}'}"
                                   FontSize="11" Foreground="#B388FF"/>
                    </StackPanel>

                    <Button Grid.Column="2" Classes="winBtn" Width="36" Height="36"
                            Click="Close_Click" VerticalAlignment="Top">
                        <TextBlock Text="✕" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Summary -->
                <Border Grid.Row="1" Background="#207C4DFF" CornerRadius="10" Padding="14,10" Margin="0,16,0,0"
                        BorderBrush="#407C4DFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-6h2v6zm0-8h-2V9h2v2z"
                                  Width="18" Height="18" Foreground="#B388FF" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SummaryText}" Foreground="#DDDDDD" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Dependencies list -->
                <Border Grid.Row="2" Background="#20000000" CornerRadius="12" Margin="0,16,0,0" ClipToBounds="True">
                    <Panel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsVisible="{Binding IsResolving}" Spacing="8">
                            <TextBlock Text="Проверка зависимостей..." Foreground="#888888" FontSize="14"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsResolving"/>
                                    <Binding Path="!HasDependencies"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Width="48" Height="48" Foreground="#66BB6A"/>
                            <TextBlock Text="Мод не требует зависимостей" FontSize="14" Foreground="#B0B0B0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Просто нажми «Установить»" FontSize="12" Foreground="#666666"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer IsVisible="{Binding HasDependencies}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Dependencies}" Padding="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:DependencyItem">
                                        <Border Background="#181225" CornerRadius="10" Padding="12" Margin="0,4"
                                                BorderBrush="#25FFFFFF" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <!-- Основная строка -->
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                              IsEnabled="{Binding CanInstall}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8"
                                                            Background="#2A1F3F" ClipToBounds="True">
                                                        <Panel>
                                                            <PathIcon Data="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"
                                                                      Foreground="#B388FF" Width="20" Height="20"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image asyncImageLoader:ImageLoader.Source="{Binding IconUrl}"
                                                                   Stretch="UniformToFill"
                                                                   behaviors:IconPlaceholderBehavior.IsEnabled="True"/>
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="White" VerticalAlignment="Center"/>

                                                            <Border Background="#40FF6666" CornerRadius="4" Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsRequired}">
                                                                <TextBlock Text="Обязательно" FontSize="9" Foreground="#FFAAAA"/>
                                                            </Border>

                                                            <Border Background="#404FC3F7" CornerRadius="4" Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsOptional}">
                                                                <TextBlock Text="Опционально" FontSize="9" Foreground="#87D9F7"/>
                                                            </Border>

                                                            <Border Background="#4066BB6A" CornerRadius="4" Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsAlreadyInstalled}">
                                                                <TextBlock Text="✓ Установлено" FontSize="9" Foreground="#99DD99"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#888888"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="#B388FF" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <!-- Кнопка "выбрать версию" (только если есть несколько версий) -->
                                                    <Button Grid.Column="3" Classes="linkBtn"
                                                            Click="ExpandVersion_Click" Tag="{Binding}"
                                                            IsVisible="{Binding HasMultipleVersions}"
                                                            VerticalAlignment="Center" Margin="6,0,0,0" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="Версия" FontSize="11" Foreground="#B388FF" VerticalAlignment="Center"/>
                                                            <PathIcon Data="M7 10l5 5 5-5z" Width="12" Height="12" Foreground="#B388FF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <!-- Раскрывающийся список версий -->
                                                <Border Background="#0DFFFFFF" CornerRadius="8" Padding="6"
                                                        IsVisible="{Binding IsExpanded}"
                                                        BorderBrush="#20FFFFFF" BorderThickness="1">
                                                    <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding AvailableVersions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="models:ModrinthVersion">
                                                                    <Button Classes="depVersionBtn"
                                                                            Click="SelectDepVersion_Click"
                                                                            Tag="{Binding}"
                                                                            Margin="0,2">
                                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="{Binding VersionNumber}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <TextBlock Text="{Binding LoadersDisplay}" FontSize="10" Foreground="#66BB6A"/>
                                                                                    <TextBlock Text="•" FontSize="10" Foreground="#444"/>
                                                                                    <TextBlock Text="{Binding GameVersionsDisplay}" FontSize="10" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                            <Border Grid.Column="1" Background="#307C4DFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0">
                                                                                <TextBlock Text="{Binding VersionType}" FontSize="9" Foreground="#B388FF"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Border>

                <!-- Progress -->
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding IsInstalling}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Progress, StringFormat={}{0:F0}%}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#B388FF"/>
                    </Grid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100"
                                 Height="6" CornerRadius="3"
                                 Background="#30FFFFFF" Foreground="#7C4DFF"/>
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="4" Margin="0,16,0,0" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding StatusText}" Foreground="#B388FF" FontSize="12"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsInstalling}"/>

                    <Button Grid.Column="1" Classes="settingsBtn" Click="Close_Click" Padding="24,0" Margin="0,0,10,0">
                        <TextBlock Text="Отмена" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button Grid.Column="2" Classes="playBtn" Click="Install_Click"
                            IsEnabled="{Binding CanInstall}" Padding="20,0" Height="44">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                <GradientStop Color="#536DFE" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                      Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Установить" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Border>
</UserControl>