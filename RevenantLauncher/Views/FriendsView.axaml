<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncher.ViewModels"
             xmlns:models="using:RevenantLauncher.Models"
             x:Class="RevenantLauncher.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">

    <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Margin="40,20,40,100" Spacing="20" MaxWidth="1100">

                <StackPanel Spacing="6">
                    <TextBlock Text="Друзья" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Находи игроков, добавляй в друзья и следи за их активностью"
                               FontSize="14" Foreground="#888888"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*">

                    <!-- ===== ЛЕВАЯ КОЛОНКА: поиск + профиль ===== -->
                    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,10,0">

                        <Border Classes="searchBox" Height="44">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding SearchQuery}" Watermark="Ник игрока..."
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14"
                                         VerticalAlignment="Center"
                                         KeyDown="SearchBox_KeyDown"/>
                                <Button Grid.Column="1" Classes="playBtn" Height="32" Margin="0,0,4,0"
                                        Click="Search_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                                  Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Найти" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Игрок не найден (Grid, а не StackPanel — чтобы текст не вылезал в правую колонку) -->
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasNoResults}">
                            <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Foreground="#B0B0B0" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding NoResultsMessage}" Foreground="#B0B0B0"
                                       FontSize="13" TextWrapping="Wrap" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Ошибка -->
                        <Border Background="#40FF4444" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasError}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                          Foreground="#FF6666" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFAAAA"
                                           FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Результаты поиска -->
                        <ItemsControl ItemsSource="{Binding SearchResults}" IsVisible="{Binding HasResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PlayerSearchResult">
                                    <Button Classes="accountItem" Margin="0,2" HorizontalContentAlignment="Stretch"
                                            Click="Result_Click" Tag="{Binding}">
                                        <Grid ColumnDefinitions="44,*,Auto">
                                            <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                        <GradientStop Color="#7C4DFF" Offset="0"/>
                                                        <GradientStop Color="#536DFE" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="14" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding FriendStatusText}" FontSize="11"
                                                           Foreground="#66BB6A" IsVisible="{Binding HasFriendStatus}"/>
                                            </StackPanel>
                                            <PathIcon Grid.Column="2" Data="M7 10l5 5 5-5z" Foreground="#888888"
                                                      Width="14" Height="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Подсказка: профиль ещё не выбран -->
                        <Border Classes="settingsSection" IsVisible="{Binding ShowProfileHint}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,24">
                                <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                      Foreground="#7C4DFF" Width="36" Height="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Найди игрока и выбери его из результатов —"
                                           FontSize="13" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock Text="здесь появится профиль и статистика"
                                           FontSize="13" Foreground="#888888" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Загрузка профиля -->
                        <TextBlock Text="Загрузка профиля..." FontSize="13" Foreground="#888888"
                                   IsVisible="{Binding IsProfileLoading}" HorizontalAlignment="Center" Margin="0,12"/>

                        <!-- Профиль выбранного игрока -->
                        <Border Classes="settingsSection" IsVisible="{Binding HasProfile}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                                <GradientStop Color="#536DFE" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Profile.Initial}" FontSize="24" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Profile.Username}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                            <Border Classes="installedBadge" VerticalAlignment="Center" IsVisible="{Binding Profile.HasFriendBadge}">
                                                <TextBlock Text="{Binding Profile.FriendBadgeText}" FontSize="10" Foreground="#A5D6A7"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Profile.CreatedAtText}" FontSize="12" Foreground="#B388FF"/>
                                            <TextBlock Text="{Binding Profile.OnlineStatusText}" FontSize="12" Foreground="{Binding Profile.OnlineStatusColor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Запусков" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding Profile.TotalSessionsText}" FontSize="16" FontWeight="SemiBold" Foreground="#B388FF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Наиграно" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding Profile.PlayTimeText}" FontSize="16" FontWeight="SemiBold" Foreground="#B388FF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Любимая версия" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding Profile.FavoriteVersionText}" FontSize="16" FontWeight="SemiBold" Foreground="#B388FF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="2" Margin="0,10,0,0">
                                        <TextBlock Text="Последняя активность" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding Profile.LastPlayedText}" FontSize="13" Foreground="White"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="playBtn" Click="ToggleFriend_Click" Padding="20,0"
                                            IsVisible="{Binding !ShowIncomingActions}">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                                <GradientStop Color="#536DFE" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                                  Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FriendButtonText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Входящая заявка: принять или отклонить -->
                                    <Button Classes="playBtn" Click="ToggleFriend_Click" Padding="20,0"
                                            IsVisible="{Binding ShowIncomingActions}">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                <GradientStop Color="#66BB6A" Offset="0"/>
                                                <GradientStop Color="#43A047" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                      Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Принять заявку" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="settingsBtn" Click="DeclineProfileRequest_Click" Padding="20,0"
                                            IsVisible="{Binding ShowIncomingActions}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                      Foreground="#DDDDDD" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Отклонить" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="playBtn" Click="PlayVersion_Click" Padding="20,0"
                                            IsVisible="{Binding HasFavoriteVersion}" ToolTip.Tip="Выбрать любимую версию этого игрока">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                <GradientStop Color="#66BB6A" Offset="0"/>
                                                <GradientStop Color="#43A047" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <PathIcon Data="M8 5v14l11-7z" Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Profile.FavoriteVersionText, StringFormat='Сыграть в {0}'}"
                                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== ПРАВАЯ КОЛОНКА: заявки + мои друзья ===== -->
                    <StackPanel Grid.Column="1" Spacing="14" Margin="10,0,0,0">

                        <!-- Входящие заявки в друзья -->
                        <StackPanel Spacing="12" IsVisible="{Binding HasRequests}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="M13 7h-2v4H7v2h4v4h2v-4h4v-2h-4V7zm-1-5C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                                          Width="20" Height="20" Foreground="#66BB6A"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Заявки в друзья" FontSize="18" FontWeight="Bold"/>
                                    <Run Text="{Binding RequestsCountText}" FontSize="14" Foreground="#888888"/>
                                </TextBlock>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding IncomingRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:FriendRequest">
                                        <Border Classes="friendCard" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="44,*,Auto">
                                                <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#66BB6A" Offset="0"/>
                                                            <GradientStop Color="#43A047" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="хочет добавить тебя в друзья" FontSize="11" Foreground="#888888"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="smallAcceptBtn" Click="AcceptRequest_Click" Tag="{Binding}">Принять</Button>
                                                    <Button Classes="smallDeclineBtn" Click="DeclineRequest_Click" Tag="{Binding}">Отклонить</Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                      Width="20" Height="20" Foreground="#B388FF"/>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Мои друзья" FontSize="18" FontWeight="Bold"/>
                                <Run Text="{Binding FriendCountText}" FontSize="14" Foreground="#888888"/>
                            </TextBlock>
                            <Button Classes="refreshBtn" Click="RefreshFriends_Click" VerticalAlignment="Center"
                                    ToolTip.Tip="Обновить список">
                                <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <!-- Загрузка списка -->
                        <TextBlock Text="Загрузка..." FontSize="13" Foreground="#888888"
                                   IsVisible="{Binding IsFriendsLoading}"/>

                        <TextBlock Text="Друзей пока нет — найди игрока слева и добавь его"
                                   FontSize="13" Foreground="#888888" IsVisible="{Binding !HasFriends}"/>

                        <ItemsControl ItemsSource="{Binding Friends}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PlayerProfile">
                                    <Border Classes="friendCard" Margin="0,0,0,8"
                                            PointerPressed="FriendCard_PointerPressed" Tag="{Binding}"
                                            Cursor="Hand" ToolTip.Tip="Открыть профиль">
                                        <Grid ColumnDefinitions="44,*,Auto,Auto">
                                            <Grid Width="44" Height="44">
                                                <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#7C4DFF" Offset="0"/>
                                                            <GradientStop Color="#536DFE" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Ellipse Width="11" Height="11" Fill="{Binding OnlineStatusColor}" Stroke="#20202C" StrokeThickness="2"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{Binding TotalSessionsText, StringFormat='запусков: {0}'}"
                                                               FontSize="11" Foreground="#B388FF" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding PlayTimeText}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding OnlineStatusText}" FontSize="12" Foreground="{Binding OnlineStatusColor}"/>
                                                    <TextBlock Text="{Binding LastPlayedText}" FontSize="12" Foreground="#B0B0B0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="chatBtn" Click="OpenChat_Click" Tag="{Binding}"
                                                    VerticalAlignment="Center" ToolTip.Tip="Открыть чат">
                                                <PathIcon Data="M4 4h16c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2h-4l-4 3-4-3H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 2v10h4.67L12 18.5 15.33 16H20V6H4z"
                                                          Width="15" Height="15"/>
                                            </Button>
                                            <Button Grid.Column="3" Classes="friendDeleteBtn" Click="RemoveFriend_Click" Tag="{Binding}"
                                                    VerticalAlignment="Center" ToolTip.Tip="Удалить из друзей">
                                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                          Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Чат с выбранным другом -->
                        <Border Classes="settingsSection" IsVisible="{Binding IsChatOpen}" Padding="16">
                            <Grid RowDefinitions="Auto,*,Auto" MinHeight="280">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ChatTitle}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ChatSubtitle}" FontSize="11" Foreground="#B388FF"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="toastClose" Click="CloseChat_Click" ToolTip.Tip="Закрыть чат">
                                        <TextBlock Text="✕" FontSize="12"/>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Margin="0,12" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:ChatMessageDto">
                                                <Border Background="{Binding IsMine, Converter={x:Static vm:ChatBubbleBrushConverter.Instance}}"
                                                        CornerRadius="10" Padding="10,7" Margin="0,3"
                                                        HorizontalAlignment="{Binding IsMine, Converter={x:Static vm:ChatBubbleAlignmentConverter.Instance}}">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" MaxWidth="360"/>
                                                        <TextBlock Text="{Binding CreatedText}" FontSize="10" Foreground="#888888" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Text="{Binding ChatInput}" Watermark="Напиши сообщение..." Classes="searchBox"
                                             KeyDown="ChatBox_KeyDown" MinHeight="38"/>
                                    <Button Grid.Column="1" Classes="playBtn" Height="38" Padding="16,0" Margin="8,0,0,0"
                                            Click="SendMessage_Click" IsEnabled="{Binding !IsSendingMessage}">
                                        <TextBlock Text="Отправить" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
