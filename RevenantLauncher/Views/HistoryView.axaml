<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncher.ViewModels"
             xmlns:models="using:RevenantLauncher.Models"
             xmlns:converters="using:RevenantLauncher.Converters"
             xmlns:behaviors="using:RevenantLauncher.Behaviors"
             x:Class="RevenantLauncher.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrush"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel Margin="40,20,40,40" Spacing="20" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="История" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Все твои игровые сессии" FontSize="14" Foreground="#888888"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="settingsBtn" Click="ClearHistory_Click" Padding="16,0"
                        IsVisible="{Binding HasSessions}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Width="16" Height="16" Foreground="#FF6666" VerticalAlignment="Center"/>
                        <TextBlock Text="Очистить" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stats cards -->
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*">

                <Border Grid.Row="0" Grid.Column="0" Classes="statCard" Margin="0,0,6,6">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M8 5v14l11-7z" Width="16" Height="16" Foreground="#B388FF"/>
                            <TextBlock Text="Всего запусков" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalSessions}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Classes="statCard" Margin="6,0,6,6">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                      Width="16" Height="16" Foreground="#66BB6A"/>
                            <TextBlock Text="Общее время" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalPlayTimeDisplay}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Classes="statCard" Margin="6,0,0,6">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                                      Width="16" Height="16" Foreground="#FFB74D"/>
                            <TextBlock Text="Любимая версия" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FavoriteVersion}" FontSize="16" FontWeight="Bold" Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Classes="statCard" Margin="0,6,6,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M13 2v2h1v3c0 1.66-1.34 3-3 3s-3-1.34-3-3V4h1V2H4v2h1v3c0 2.42 1.72 4.44 4 4.9V14c-1.66 0-3 1.34-3 3v5h12v-5c0-1.66-1.34-3-3-3v-2.1c2.28-.46 4-2.48 4-4.9V4h1V2h-6z"
                                      Width="16" Height="16" Foreground="#FF6666"/>
                            <TextBlock Text="Дольше всего" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LongestSessionDisplay}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Classes="statCard" Margin="6,6,6,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"
                                      Width="16" Height="16" Foreground="#4FC3F7"/>
                            <TextBlock Text="Средняя сессия" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AverageSessionDisplay}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Classes="statCard" Margin="6,6,0,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                                      Width="16" Height="16" Foreground="#B388FF"/>
                            <TextBlock Text="Первый запуск" FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FirstSessionDisplay}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Activity graph -->
            <Border Classes="settingsSection" IsVisible="{Binding HasSessions}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z"
                                  Width="20" Height="20" Foreground="#B388FF"/>
                        <TextBlock Text="Активность за 30 дней" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#0DFFFFFF" CornerRadius="10" Padding="12">
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DayActivityItem">
                                    <StackPanel Spacing="4" Width="30">
                                        <Border Width="24" Height="90" VerticalAlignment="Bottom">
                                            <Border Height="{Binding BarHeight}" Width="24"
                                                    VerticalAlignment="Bottom" CornerRadius="4"
                                                    ToolTip.Tip="{Binding HoursDisplay}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                                                        <GradientStop Color="#7C4DFF" Offset="0"/>
                                                        <GradientStop Color="#B388FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding DayLabel}" FontSize="9" Foreground="#666666"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Filters -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasSessions}">
                <Border Classes="searchBox">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Foreground="#888888" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                 Watermark="Поиск по версии или аккаунту..."
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontSize="14"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                    <Button Classes.tabActive="{Binding PeriodAllActive}" Classes.tab="{Binding !PeriodAllActive}" Click="PeriodAll_Click">
                        <TextBlock Text="Всё" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Classes.tabActive="{Binding PeriodTodayActive}" Classes.tab="{Binding !PeriodTodayActive}" Click="PeriodToday_Click">
                        <TextBlock Text="Сегодня" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Classes.tabActive="{Binding PeriodWeekActive}" Classes.tab="{Binding !PeriodWeekActive}" Click="PeriodWeek_Click">
                        <TextBlock Text="Неделя" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Classes.tabActive="{Binding PeriodMonthActive}" Classes.tab="{Binding !PeriodMonthActive}" Click="PeriodMonth_Click">
                        <TextBlock Text="Месяц" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status filter -->
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSessions}">
                <Button Classes.tabActive="{Binding StatusAllActive}" Classes.tab="{Binding !StatusAllActive}" Click="StatusAll_Click">
                    <TextBlock Text="Все статусы" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes.tabActive="{Binding StatusCompletedActive}" Classes.tab="{Binding !StatusCompletedActive}" Click="StatusCompleted_Click">
                    <TextBlock Text="Успешные" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes.tabActive="{Binding StatusFailedActive}" Classes.tab="{Binding !StatusFailedActive}" Click="StatusFailed_Click">
                    <TextBlock Text="С ошибками" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Empty state -->
            <Border Background="#20000000" CornerRadius="12" Padding="40" IsVisible="{Binding !HasSessions}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                              Width="64" Height="64" Foreground="#3A3050"/>
                    <TextBlock Text="Пока нет запусков" FontSize="18" FontWeight="SemiBold"
                               Foreground="#B0B0B0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Запусти игру, и здесь появится история сессий"
                               FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Sessions list -->
            <ItemsControl ItemsSource="{Binding DisplayedSessions}" IsVisible="{Binding HasSessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SessionItem">
                        <Border Classes="sessionCard" Margin="0,4" behaviors:StaggeredAnimationBehavior.IsEnabled="True">
                            <StackPanel Spacing="10">
                                <Button Classes="sessionHeader" Click="SessionCard_Click" Tag="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                VerticalAlignment="Center" Margin="0,0,14,0"
                                                Background="{Binding StatusColor, Converter={StaticResource StringToBrush}}"/>

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding VersionDisplayName}" FontSize="15"
                                                           FontWeight="SemiBold" Foreground="White"/>
                                                <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{Binding LoaderColor, Converter={StaticResource StringToBrush}}">
                                                    <TextBlock Text="{Binding LoaderType}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding StartedAtDisplay}" FontSize="12" Foreground="#888888"/>
                                                <TextBlock Text="•" FontSize="12" Foreground="#555555"/>
                                                <TextBlock Text="{Binding AccountUsername}" FontSize="12" Foreground="#B388FF"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="20,0,20,0">
                                            <TextBlock Text="{Binding DurationDisplay}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                       Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <PathIcon Grid.Column="3" Data="M7 10l5 5 5-5z" Width="20" Height="20"
                                                  Foreground="#666666" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <Border IsVisible="{Binding IsExpanded}" Background="#0DFFFFFF"
                                        CornerRadius="8" Padding="14" Margin="24,0,0,0">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Начало:" FontSize="12"
                                                   Foreground="#888888" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StartedAtShort}"
                                                   FontSize="12" Foreground="White" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Конец:" FontSize="12"
                                                   Foreground="#888888" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndedAtDisplay}"
                                                   FontSize="12" Foreground="White" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ID версии:" FontSize="12"
                                                   Foreground="#888888" Margin="0,0,16,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VersionId}"
                                                   FontSize="12" Foreground="White" Margin="0,0,0,6"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Код выхода:" FontSize="12"
                                                   Foreground="#888888" Margin="0,0,16,6"
                                                   IsVisible="{Binding ExitCode, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExitCode}"
                                                   FontSize="12" Foreground="White" Margin="0,0,0,6"
                                                   IsVisible="{Binding ExitCode, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ошибка:" FontSize="12"
                                                   Foreground="#FF6666" Margin="0,0,16,0"
                                                   IsVisible="{Binding HasError}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ErrorMessage}"
                                                   FontSize="12" Foreground="#FFAAAA" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasError}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>