<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RevenantLauncher.Views.SplashWindow"
        Width="648" Height="308"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- Margin 24 — место под собственную скруглённую тень -->
    <Border Name="RootBorder" CornerRadius="20" ClipToBounds="True"
            BorderBrush="#40FFFFFF" BorderThickness="1"
            Margin="24" BoxShadow="0 6 18 0 #AA000000">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="80%" RadiusY="120%">
                <GradientStop Color="#2A1F3F" Offset="0"/>
                <GradientStop Color="#1A1025" Offset="0.6"/>
                <GradientStop Color="#0D0518" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Panel>

            <!-- Пульсирующее свечение фон -->
            <Ellipse Name="GlowPulse"
                     Width="500" Height="200"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#607C4DFF" Offset="0"/>
                        <GradientStop Color="#207C4DFF" Offset="0.5"/>
                        <GradientStop Color="#007C4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid RowDefinitions="*,Auto" Margin="40,30,40,20">

                <!-- Логотип по центру -->
                <Border Name="LogoContainer" Grid.Row="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="avares://RevenantLauncher/Assets/launcher.png"
                           Height="130"
                           Stretch="Uniform"/>
                </Border>

                <!-- Индикатор загрузки внизу -->
                <StackPanel Grid.Row="1" Name="LoadingContainer" Spacing="10" Margin="0,15,0,0">

                    <!-- Прогресс-бар -->
                    <Border Background="#20FFFFFF" CornerRadius="4" Height="4" ClipToBounds="True">
                        <Border Name="ProgressFill"
                                HorizontalAlignment="Left"
                                CornerRadius="4"
                                Width="0" Height="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#7C4DFF" Offset="0"/>
                                    <GradientStop Color="#B388FF" Offset="0.5"/>
                                    <GradientStop Color="#536DFE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <!-- Статус текст -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="StatusText" Text="Загрузка..." FontSize="11"
                                   Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Name="ProgressText" Text="0%" FontSize="11"
                                   Foreground="#B388FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Grid>

        </Panel>
    </Border>

</Window>