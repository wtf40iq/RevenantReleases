<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevenantLauncher.ViewModels"
        x:Class="RevenantLauncher.Views.AuthWindow"
        x:DataType="vm:AuthViewModel"
        Width="480" Height="700"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        ShowInTaskbar="True"
        Topmost="False">

    <!-- Margin 24 — место под собственную скруглённую тень -->
    <Border Name="RootBorder" CornerRadius="20" ClipToBounds="True"
            BorderBrush="#40FFFFFF" BorderThickness="1"
            Margin="24" BoxShadow="0 6 24 0 #CC000000">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="80%" RadiusY="120%">
                <GradientStop Color="#2A1F3F" Offset="0"/>
                <GradientStop Color="#1A1025" Offset="0.6"/>
                <GradientStop Color="#0D0518" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Panel>

            <!-- Пульсирующее свечение фона -->
            <Ellipse Name="GlowPulse"
                     Width="420" Height="260"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#507C4DFF" Offset="0"/>
                        <GradientStop Color="#187C4DFF" Offset="0.5"/>
                        <GradientStop Color="#007C4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid RowDefinitions="Auto,*" Margin="32,24,32,28">

                <!-- Заголовок: лого + кнопка закрытия. Область для перетаскивания окна -->
                <Grid Grid.Row="0" Name="DragArea" ColumnDefinitions="*,Auto" PointerPressed="DragArea_PointerPressed">
                    <Image Source="avares://RevenantLauncher/Assets/launcher.png"
                           Height="70" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <Button Grid.Column="1" Width="36" Height="36" Click="Close_Click"
                            Background="#15FFFFFF" BorderThickness="0" CornerRadius="10"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <TextBlock Text="✕" FontSize="14" Foreground="#CCCCCC"/>
                    </Button>
                </Grid>

                <!-- Форма -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel Spacing="16" Margin="4,0,10,0">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Добро пожаловать" FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Войди или создай аккаунт Revenant" FontSize="13" Foreground="#999999"/>
                        </StackPanel>

                        <!-- Вкладки -->
                        <Border Background="#15FFFFFF" CornerRadius="12" Padding="4">
                            <Grid ColumnDefinitions="*,*">
                                <Border Name="LoginTabBg" CornerRadius="9" Height="40">
                                    <Button Name="LoginTabBtn" Click="TabLogin_Click"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <TextBlock Text="Вход" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    </Button>
                                </Border>
                                <Border Grid.Column="1" Name="RegisterTabBg" CornerRadius="9" Height="40">
                                    <Button Name="RegisterTabBtn" Click="TabRegister_Click"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <TextBlock Text="Регистрация" FontSize="14" FontWeight="SemiBold" Foreground="#999999"/>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Никнейм -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Никнейм" FontSize="12" Foreground="#B0B0B0"/>
                            <Border Background="#15FFFFFF" CornerRadius="10" Height="46"
                                    BorderBrush="#25FFFFFF" BorderThickness="1">
                                <TextBox Text="{Binding Username}"
                                         Watermark="Введи никнейм..."
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14" CaretBrush="#B388FF"
                                         SelectionBrush="#607C4DFF"
                                         VerticalAlignment="Center" Margin="10,0"
                                         KeyDown="Field_KeyDown"/>
                            </Border>
                        </StackPanel>

                        <!-- Пароль -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Пароль" FontSize="12" Foreground="#B0B0B0"/>
                            <Border Background="#15FFFFFF" CornerRadius="10" Height="46"
                                    BorderBrush="#25FFFFFF" BorderThickness="1">
                                <TextBox Text="{Binding Password}"
                                         Watermark="Введи пароль..."
                                         PasswordChar="•"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14" CaretBrush="#B388FF"
                                         SelectionBrush="#607C4DFF"
                                         VerticalAlignment="Center" Margin="10,0"
                                         KeyDown="Field_KeyDown"/>
                            </Border>
                        </StackPanel>

                        <!-- Подтверждение пароля (только регистрация) -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsRegisterTab}">
                            <TextBlock Text="Повтори пароль" FontSize="12" Foreground="#B0B0B0"/>
                            <Border Background="#15FFFFFF" CornerRadius="10" Height="46"
                                    BorderBrush="#25FFFFFF" BorderThickness="1">
                                <TextBox Text="{Binding ConfirmPassword}"
                                         Watermark="Повтори пароль..."
                                         PasswordChar="•"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14" CaretBrush="#B388FF"
                                         SelectionBrush="#607C4DFF"
                                         VerticalAlignment="Center" Margin="10,0"
                                         KeyDown="Field_KeyDown"/>
                            </Border>
                        </StackPanel>

                        <!-- Ошибка -->
                        <Border Background="#40FF4444" CornerRadius="8" Padding="12,10"
                                IsVisible="{Binding HasError}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                          Foreground="#FF6666" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFAAAA"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопка отправки -->
                        <Button Name="SubmitBtn" Click="Submit_Click"
                                Height="50" IsEnabled="{Binding !IsBusy}"
                                HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="12"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#7C4DFF" Offset="0"/>
                                    <GradientStop Color="#536DFE" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="{Binding SubmitButtonDisplayText}"
                                       FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- Подсказка, что нужно подождать (сервер на free-тарифе просыпается) -->
                        <Border Background="#207C4DFF" CornerRadius="8" Padding="12,10"
                                BorderBrush="#407C4DFF" BorderThickness="1"
                                IsVisible="{Binding ShowWaitHint}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-6h2v6zm0-8h-2V7h2v6z"
                                          Foreground="#B388FF" Width="18" Height="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock Text="Соединение с сервером..."
                                           Foreground="#DDDDDD" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Аккаунт нужен для входа в лаунчер. Это не аккаунт Minecraft."
                                   FontSize="11" Foreground="#666666" TextAlignment="Center"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Panel>
    </Border>

</Window>
