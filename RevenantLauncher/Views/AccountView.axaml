<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncher.ViewModels"
             x:Class="RevenantLauncher.Views.AccountView"
             x:DataType="vm:AccountViewModel">

    <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Margin="40,20,40,100" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

                <StackPanel Spacing="6">
                    <TextBlock Text="Аккаунт" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Твой профиль Revenant и безопасность"
                               FontSize="14" Foreground="#888888"/>
                </StackPanel>

                <!-- ===== PROFILE ===== -->
                <Border Classes="settingsSection">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Width="20" Height="20" Foreground="#B388FF"/>
                            <TextBlock Text="Профиль" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <!-- Аватар -->
                            <Border Width="72" Height="72" CornerRadius="36" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#7C4DFF" Offset="0"/>
                                        <GradientStop Color="#536DFE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding Initial}" FontSize="32" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding UserId, StringFormat='ID: {0}'}"
                                           FontSize="12" Foreground="#888888"/>
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Регистрация" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding CreatedAtText}" FontSize="13" Foreground="#B388FF"/>
                                    </StackPanel>
                                    <Rectangle Width="1" Fill="#20FFFFFF"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Последний вход" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding LastLoginText}" FontSize="13" Foreground="#B388FF"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== SECURITY ===== -->
                <Border Classes="settingsSection">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                                      Width="20" Height="20" Foreground="#B388FF"/>
                            <TextBlock Text="Безопасность" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Текущий IP" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentIp}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#B388FF" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="Последний вход" FontSize="12" Foreground="#888888"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastLoginText}" FontSize="13"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#20FFFFFF"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="История входов (последние 5)" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LoginHistoryText}" FontSize="12" Foreground="#B0B0B0"
                                       TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== CHANGE PASSWORD ===== -->
                <Border Classes="settingsSection">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                      Width="20" Height="20" Foreground="#B388FF"/>
                            <TextBlock Text="Смена пароля" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Текущий пароль" FontSize="13" Foreground="#B0B0B0"/>
                            <Border Classes="searchBox" Height="44">
                                <TextBox Text="{Binding CurrentPassword}" PasswordChar="•"
                                         Watermark="Введи текущий пароль..."
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Spacing="8" Margin="0,0,6,0">
                                <TextBlock Text="Новый пароль" FontSize="13" Foreground="#B0B0B0"/>
                                <Border Classes="searchBox" Height="44">
                                    <TextBox Text="{Binding NewPassword}" PasswordChar="•"
                                             Watermark="Минимум 6 символов..."
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="14"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" Margin="6,0,0,0">
                                <TextBlock Text="Повтори новый пароль" FontSize="13" Foreground="#B0B0B0"/>
                                <Border Classes="searchBox" Height="44">
                                    <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•"
                                             Watermark="Ещё раз..."
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" FontSize="14"
                                             VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Ошибка -->
                        <Border Background="#40FF4444" CornerRadius="8" Padding="12,10"
                                IsVisible="{Binding HasError}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                          Foreground="#FF6666" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFAAAA"
                                           FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Успех -->
                        <Border Background="#4000CC66" CornerRadius="8" Padding="12,10"
                                IsVisible="{Binding HasSuccess}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                          Foreground="#66DD99" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SuccessMessage}" Foreground="#AAFFCC"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Classes="playBtn" Click="ChangePassword_Click"
                                IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" Padding="24,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#7C4DFF" Offset="0"/>
                                    <GradientStop Color="#536DFE" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                          Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Сменить пароль" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ===== LOGOUT ===== -->
                <Border Classes="settingsSection">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Выйти из аккаунта" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Лаунчер перезапустится и покажет окно входа"
                                       FontSize="12" Foreground="#888888"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="settingsBtn" Click="Logout_Click" Padding="20,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"
                                          Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Выйти" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
