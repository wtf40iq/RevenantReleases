<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncher.ViewModels"
             xmlns:models="using:RevenantLauncher.Models"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:behaviors="using:RevenantLauncher.Behaviors"
             x:Class="RevenantLauncher.Views.ModsView"
             x:DataType="vm:ModsViewModel">

    <UserControl.Resources>
        <!-- Карточка установленного мода (используется в аккордеоне папок версий) -->
        <DataTemplate x:Key="InstalledModTemplate" DataType="models:ModInfo">
            <Border Classes="modCard" Margin="0,4">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#2A1F3F" ClipToBounds="True">
                        <Panel>
                            <PathIcon Data="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"
                                      Foreground="#B388FF" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                   IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                            <Border Background="#307C4DFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#B388FF"/></Border>
                            <Border Background="#3066BB6A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LoaderDisplay}" FontSize="10" Foreground="#88DD99"/></Border>
                            <Border Background="#40FFB300" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    IsVisible="{Binding HasUpdate}">
                                <TextBlock Text="{Binding UpdateBadgeText}" FontSize="10" Foreground="#FFCC66"/></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Authors}" FontSize="11" Foreground="#666666"/>
                            <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="playBtn" Click="UpdateMod_Click" Tag="{Binding}"
                            Height="36" Padding="12,0" VerticalAlignment="Center" Margin="10,0"
                            IsVisible="{Binding HasUpdate}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#FFB300" Offset="0"/>
                                <GradientStop Color="#FF8F00" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z"
                                      Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Обновить" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=OneWay}" Click="ToggleMod_Click" Tag="{Binding}" Margin="10,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="4" Classes="iconBtn" Click="RemoveMod_Click" Tag="{Binding}" Margin="4,0" VerticalAlignment="Center">
                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Width="18" Height="18" Foreground="#FF6666"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox.modsListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ListBox.modsListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="ListBox.modsListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.modsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="40,20,40,20">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Моды" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatsDisplay}" FontSize="14" Foreground="#888888"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#30FFB300" CornerRadius="8" Padding="10,6" VerticalAlignment="Center"
                            IsVisible="{Binding HasUpdatesAvailable}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z"
                                      Foreground="#FFCC66" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdatesAvailable, StringFormat='Обновлений: {0}'}" FontSize="12" Foreground="#FFCC66" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="settingsBtn" Click="Refresh_Click" Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Обновить" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="settingsBtn" Click="OpenFolder_Click" Padding="16,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Открыть папку" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="settingsBtn" Click="ExportPack_Click" Padding="16,0" ToolTip.Tip="Экспорт сборки в .mrpack">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                      Width="16" Height="16" VerticalAlignment="Center"
                                      RenderTransform="rotate(180deg)"/>
                            <TextBlock Text="Экспорт" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="settingsBtn" Click="ImportPack_Click" Padding="16,0" ToolTip.Tip="Импорт сборки из .mrpack">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Импорт" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="playBtn" Click="AddMods_Click" Padding="20,0" Height="44">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                <GradientStop Color="#536DFE" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <PathIcon Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                      Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Добавить моды" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,20,0,0">
                <Button Classes.tabActive="{Binding IsInstalledTab}" Classes.tab="{Binding !IsInstalledTab}"
                        Click="TabInstalled_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Width="16" Height="16"/>
                        <TextBlock Text="Установленные" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Classes.tabActive="{Binding IsBrowseTab}" Classes.tab="{Binding !IsBrowseTab}"
                        Click="TabBrowse_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Width="16" Height="16"/>
                        <TextBlock Text="Поиск на Modrinth" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Search -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,12">
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsInstalledTab}">
                    <Border Classes="searchBox">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Foreground="#888888" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Поиск установленных модов..."
                                     Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                        <Button Classes.tabActive="{Binding FilterAllActive}" Classes.tab="{Binding !FilterAllActive}" Click="FilterAll_Click">
                            <TextBlock Text="Все" VerticalAlignment="Center" HorizontalAlignment="Center"/></Button>
                        <Button Classes.tabActive="{Binding FilterEnabledActive}" Classes.tab="{Binding !FilterEnabledActive}" Click="FilterEnabled_Click">
                            <TextBlock Text="Включённые" VerticalAlignment="Center" HorizontalAlignment="Center"/></Button>
                        <Button Classes.tabActive="{Binding FilterDisabledActive}" Classes.tab="{Binding !FilterDisabledActive}" Click="FilterDisabled_Click">
                            <TextBlock Text="Выключённые" VerticalAlignment="Center" HorizontalAlignment="Center"/></Button>
                    </StackPanel>
                </Grid>
                <Border Classes="searchBox" IsVisible="{Binding IsBrowseTab}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Foreground="#888888" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding BrowseSearchText}" Watermark="Найти моды на Modrinth (JEI, Sodium, Iris...)"
                                 Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                                 VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Поиск..." Foreground="#B388FF" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsSearching}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Content -->
            <Panel Grid.Row="3">
                <!-- INSTALLED -->
                <Border Background="#20000000" CornerRadius="12" ClipToBounds="True" IsVisible="{Binding IsInstalledTab}">
                    <Panel>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsLoading}" Spacing="10">
                            <TextBlock Text="Загрузка..." Foreground="#888888" FontSize="14"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="2" Margin="8">

                                <TextBlock Text="Пока нет ни одной папки с модами — установи моды через «Добавить моды»"
                                           Foreground="#888888" FontSize="13" Margin="4,10"
                                           IsVisible="{Binding !HasVersionFolders}"/>

                                <ItemsControl ItemsSource="{Binding VersionFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ModFolderGroup">
                                            <StackPanel Spacing="0">

                                                <!-- Шапка папки версии -->
                                                <Border Classes="modCard" Padding="10,8" Margin="0,3">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Button Grid.Column="0" Classes="iconBtn" Width="32" Height="32"
                                                                Click="ToggleFolder_Click" Tag="{Binding}" VerticalAlignment="Center">
                                                            <Panel>
                                                                <PathIcon Data="M7 10l5 5 5-5z" Width="18" Height="18" Foreground="#B388FF"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          IsVisible="{Binding !IsExpanded}"/>
                                                                <PathIcon Data="M7 14l5-5 5 5z" Width="18" Height="18" Foreground="#B388FF"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          IsVisible="{Binding IsExpanded}"/>
                                                            </Panel>
                                                        </Button>

                                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,0"
                                                                Click="ToggleFolder_Click" Tag="{Binding}"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                <PathIcon Data="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.1 0 2-.89 2-2V8c0-1.1-.9-2-2-2z"
                                                                          Width="18" Height="18" Foreground="#FFCC66" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                                           Foreground="White" VerticalAlignment="Center"/>
                                                                <Border Background="#307C4DFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ModCount, StringFormat='{}{0} мод.'}" FontSize="10" Foreground="#B388FF"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Button>

                                                        <Border Grid.Column="2" Background="#3066BB6A" CornerRadius="4" Padding="8,3"
                                                                VerticalAlignment="Center" Margin="6,0"
                                                                IsVisible="{Binding IsActive}">
                                                            <TextBlock Text="Активная" FontSize="10" Foreground="#88DD99"/>
                                                        </Border>

                                                        <Button Grid.Column="3" Classes="settingsBtn" Click="ActivateFolder_Click" Tag="{Binding}"
                                                                Padding="12,0" Height="32" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                IsVisible="{Binding !IsActive}">
                                                            <TextBlock Text="Выбрать" FontSize="12" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Моды папки (когда раскрыта) -->
                                                <StackPanel IsVisible="{Binding IsExpanded}" Margin="26,0,0,6">
                                                    <TextBlock Text="Загрузка..." Foreground="#888888" FontSize="12"
                                                               IsVisible="{Binding IsLoading}" Margin="4,6"/>
                                                    <TextBlock Text="В этой папке нет модов." Foreground="#666666" FontSize="12"
                                                               IsVisible="{Binding ShowEmptyHint}" Margin="4,6"/>
                                                    <ItemsControl ItemsSource="{Binding Mods}"
                                                                  ItemTemplate="{StaticResource InstalledModTemplate}"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>
                </Border>

                <!-- BROWSE -->
                <Border Background="#20000000" CornerRadius="12" ClipToBounds="True" IsVisible="{Binding IsBrowseTab}">
                    <ListBox Classes="modsListBox" Name="BrowseScroller" ItemsSource="{Binding BrowseResults}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:ModrinthProject">
                                <Border Classes="modCard modCardClickable" Margin="0,4"
                                        behaviors:StaggeredAnimationBehavior.IsEnabled="True"
                                        PointerPressed="ModCard_PointerPressed" Tag="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#2A1F3F" ClipToBounds="True">
                                            <Panel>
                                                <PathIcon Data="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"
                                                          Foreground="#B388FF" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image asyncImageLoader:ImageLoader.Source="{Binding IconUrl}" Stretch="UniformToFill"
                                                       behaviors:IconPlaceholderBehavior.IsEnabled="True"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                                <Border Background="#307C4DFF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DownloadsDisplay}" FontSize="10" Foreground="#B388FF"/></Border>
                                                <Border Background="#4066BB6A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsInstalled}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                                                  Width="10" Height="10" Foreground="#88DD99"/>
                                                        <TextBlock Text="Установлено" FontSize="10" Foreground="#88DD99"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Author, StringFormat='by {0}'}" FontSize="11" Foreground="#666666"/>
                                        </StackPanel>

                                        <!-- Кнопка: Установить или Удалить -->
                                        <Panel Grid.Column="2">
                                            <Button Classes="playBtn" Click="InstallMod_Click" Tag="{Binding}"
                                                    Height="40" Padding="16,0" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsNotInstalled}">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                        <GradientStop Color="#7C4DFF" Offset="0"/>
                                                        <GradientStop Color="#536DFE" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Установить" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Classes="playBtn" Click="RemoveModByProject_Click" Tag="{Binding}"
                                                    Height="40" Padding="16,0" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsInstalled}">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                        <GradientStop Color="#FF6666" Offset="0"/>
                                                        <GradientStop Color="#E53935" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Удалить" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Panel>

            <!-- Pagination -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding IsBrowseTab}">
                <TextBlock Text="{Binding PageInfoText}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="tab" Click="PrevPage_Click" IsEnabled="{Binding HasPrevPage}" Padding="10,0">
                        <TextBlock Text="‹" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:PageItem">
                                <Button Classes.tabActive="{Binding IsCurrent}"
                                        Classes.tab="{Binding !IsCurrent}"
                                        Click="PageBtn_Click" Tag="{Binding}"
                                        IsEnabled="{Binding !IsEllipsis}"
                                        Padding="10,0" MinWidth="38">
                                    <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="tab" Click="NextPage_Click" IsEnabled="{Binding HasNextPage}" Padding="10,0">
                        <TextBlock Text="›" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Download status -->
            <Border Grid.Row="5" Classes="quickLaunch" Margin="0,8,0,0" IsVisible="{Binding IsDownloading}">
                <TextBlock Text="{Binding DownloadStatus}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Panel>
</UserControl>