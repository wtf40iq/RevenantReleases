<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncher.ViewModels"
             x:Class="RevenantLauncher.Views.ConfirmDialog"
             x:DataType="vm:ConfirmDialogViewModel">

    <Border Background="#B0000000" ClipToBounds="True">
        <Border Background="{DynamicResource DialogBackground}"
                CornerRadius="{DynamicResource SectionCornerRadius}"
                BorderBrush="{DynamicResource DialogBorderBrush}"
                BorderThickness="1"
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 20 60 0 #80000000">
            <StackPanel Margin="24" Spacing="18">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="winBtn" Width="36" Height="36" Click="Cancel_Click">
                        <TextBlock Text="✕" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Message -->
                <TextBlock Text="{Binding Message}" FontSize="14" Foreground="#B0B0B0"
                           TextWrapping="Wrap" LineHeight="20"/>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Classes="settingsBtn" Click="Cancel_Click" Padding="24,0">
                        <TextBlock Text="{Binding CancelText}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="playBtn" Click="Confirm_Click" Padding="24,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                <GradientStop Color="#536DFE" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="{Binding ConfirmText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>
</UserControl>
