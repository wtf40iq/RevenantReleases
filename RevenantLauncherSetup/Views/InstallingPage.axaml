<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncherSetup.ViewModels"
             x:Class="RevenantLauncherSetup.Views.InstallingPage"
             x:DataType="vm:SetupViewModel">

    <Border Classes="page">
        <Grid Margin="40,30,40,30">
            <StackPanel VerticalAlignment="Center" Spacing="30">

                <!-- Иконка -->
                <Border Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Center"
                        Background="#307C4DFF" BorderBrush="#607C4DFF" BorderThickness="2">
                    <Panel>
                        <!-- Иконка установки (стрелка вниз) -->
                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                  Width="48" Height="48" Foreground="#B388FF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding !IsUninstallingPage}"/>
                        <!-- Иконка удаления (корзина) -->
                        <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Width="48" Height="48" Foreground="#B388FF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding IsUninstallingPage}"/>
                    </Panel>
                </Border>

                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding InstallingTitle}" Classes="pageTitle"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding InstallingSubtitle}"
                               Classes="pageSubtitle" TextAlignment="Center"
                               MaxWidth="380"/>
                </StackPanel>

                <!-- Прогресс-бар: фиксированная дорожка 380px, заливка по ширине -->
                <StackPanel Spacing="10" Width="380" HorizontalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto" Width="380">
                        <TextBlock Text="{Binding InstallStatus}" FontSize="12"
                                   Foreground="#DDDDDD" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding InstallProgressText}"
                                   FontSize="12" FontWeight="Bold" Foreground="#B388FF"/>
                    </Grid>

                    <Border Background="#20FFFFFF" CornerRadius="4" Height="8" Width="380"
                            ClipToBounds="True" HorizontalAlignment="Center">
                        <Border HorizontalAlignment="Left" Height="8"
                                Width="{Binding InstallProgressWidth}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#7C4DFF" Offset="0"/>
                                    <GradientStop Color="#B388FF" Offset="0.5"/>
                                    <GradientStop Color="#536DFE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </StackPanel>

                <Border Classes="infoBox" MaxWidth="380" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-6h2v6zm0-8h-2V9h2v2z"
                                  Width="16" Height="16" Foreground="#B388FF" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding InstallingHint}"
                                   Foreground="#DDDDDD" FontSize="11" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>