<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevenantLauncherSetup.ViewModels"
        xmlns:views="using:RevenantLauncherSetup.Views"
        x:Class="RevenantLauncherSetup.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="{Binding WindowTitle}"
        Width="500" Height="720"
        MinWidth="500" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Icon="avares://RevenantLauncherSetup/Assets/Rlogo.png">

    <Border CornerRadius="20" ClipToBounds="True"
            PointerPressed="Window_PointerPressed">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="50%,0%" Center="50%,0%" RadiusX="100%" RadiusY="100%">
                <GradientStop Color="#2A1F3F" Offset="0"/>
                <GradientStop Color="#1A1025" Offset="0.5"/>
                <GradientStop Color="#0D0518" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Panel>

            <!-- Пульсирующее свечение на фоне -->
            <Ellipse Width="600" Height="400" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-100,0,0"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#307C4DFF" Offset="0"/>
                        <GradientStop Color="#007C4DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- ===== ВЕРХНЯЯ ПАНЕЛЬ ===== -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,18,20,10">

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Image Source="avares://RevenantLauncherSetup/Assets/fonlogo.png"
                               Width="44" Height="44" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="REVENANT LAUNCHER" FontSize="14" FontWeight="Bold"
                                       Foreground="White" LineHeight="16"/>
                            <TextBlock Text="{Binding EditionText}" FontSize="11" Foreground="#888888"
                                       LineHeight="13"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1"/>

                    <Button Grid.Column="2" Classes="winBtnClose"
                            Click="Close_Click" IsEnabled="{Binding CanClose}"
                            VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- ===== СТРАНИЦЫ ===== -->
                <Panel Grid.Row="1" Margin="0,10,0,0">

                    <views:WelcomePage IsVisible="{Binding IsWelcomePage}"/>
                    <views:LicensePage IsVisible="{Binding IsLicensePage}"/>
                    <views:LocationPage IsVisible="{Binding IsLocationPage}"/>
                    <views:InstallingPage IsVisible="{Binding IsInstallingPage}"/>
                    <views:FinishPage IsVisible="{Binding IsFinishPage}"/>
                    <views:UninstallConfirmPage IsVisible="{Binding IsUninstallConfirmPage}"/>
                    <views:InstallingPage IsVisible="{Binding IsUninstallingPage}"/>
                    <views:UninstallFinishPage IsVisible="{Binding IsUninstallFinishPage}"/>

                </Panel>

                <!-- ===== FOOTER ===== -->
                <Border Grid.Row="2" Height="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#007C4DFF" Offset="0"/>
                            <GradientStop Color="#7C4DFF" Offset="0.5"/>
                            <GradientStop Color="#007C4DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

            </Grid>
        </Panel>
    </Border>

</Window>