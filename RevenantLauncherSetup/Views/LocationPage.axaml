<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncherSetup.ViewModels"
             x:Class="RevenantLauncherSetup.Views.LocationPage"
             x:DataType="vm:SetupViewModel">

    <Border Classes="page">
        <Grid RowDefinitions="Auto,*,Auto" Margin="30,20,30,25">

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z"
                              Width="22" Height="22" Foreground="#B388FF" VerticalAlignment="Center"/>
                    <TextBlock Text="Куда установить?" Classes="pageTitle" FontSize="20"/>
                </StackPanel>
                <TextBlock Text="Выберите папку для установки Revenant Launcher"
                           Classes="pageSubtitle"/>
            </StackPanel>

            <!-- Контент -->
            <StackPanel Grid.Row="1" Spacing="18" VerticalAlignment="Top">

                <!-- Путь установки -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Путь установки" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Classes="pathBox" Text="{Binding InstallPath}"/>
                        <Button Grid.Column="1" Classes="browseBtn" Margin="10,0,0,0" Click="Browse_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2z"
                                          Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Обзор..." FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="Требуется ~180 МБ свободного места" FontSize="11" Foreground="#666666"/>
                </StackPanel>

                <Rectangle Height="1" Fill="#20FFFFFF" Margin="0,4"/>

                <!-- Опции -->
                <StackPanel Spacing="14">
                    <TextBlock Text="Дополнительные опции" FontSize="13" FontWeight="SemiBold" Foreground="White"/>

                    <CheckBox IsChecked="{Binding CreateDesktopShortcut}" Foreground="#DDDDDD">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z"
                                      Width="16" Height="16" Foreground="#B388FF" VerticalAlignment="Center"/>
                            <TextBlock Text="Создать ярлык на рабочем столе" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding CreateStartMenuShortcut}" Foreground="#DDDDDD">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M3 5v14h18V5H3zm16 12H5V7h14v10z M7 9h4v2H7zm0 4h4v2H7zm6-4h4v2h-4zm0 4h4v2h-4z"
                                      Width="16" Height="16" Foreground="#66BB6A" VerticalAlignment="Center"/>
                            <TextBlock Text="Добавить в меню Пуск" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding LaunchAfterInstall}" Foreground="#DDDDDD">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M8 5v14l11-7z" Width="16" Height="16" Foreground="#7C4DFF" VerticalAlignment="Center"/>
                            <TextBlock Text="Запустить лаунчер после установки" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>

            </StackPanel>

            <!-- Кнопки -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
                <Button Grid.Column="0" Classes="secondaryBtn" Click="Back_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"
                                  Width="16" Height="16" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="Назад" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Classes="primaryBtn" Click="Install_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                  Width="16" Height="16" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="Установить" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#7C4DFF" Offset="0"/>
                            <GradientStop Color="#536DFE" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </Grid>

        </Grid>
    </Border>
</UserControl>