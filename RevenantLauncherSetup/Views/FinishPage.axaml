<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RevenantLauncherSetup.ViewModels"
             x:Class="RevenantLauncherSetup.Views.FinishPage"
             x:DataType="vm:SetupViewModel">

    <Border Classes="page">
        <Grid RowDefinitions="*,Auto" Margin="40,30,40,30">

            <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="24">

                <!-- Иконка успеха/ошибки -->
                <Panel HorizontalAlignment="Center">
                    <!-- Успех -->
                    <Border Width="110" Height="110" CornerRadius="55"
                            Background="#3066BB6A" BorderBrush="#6066BB6A" BorderThickness="2"
                            IsVisible="{Binding !InstallFailed}">
                        <PathIcon Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                  Width="56" Height="56" Foreground="#66BB6A"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Ошибка -->
                    <Border Width="110" Height="110" CornerRadius="55"
                            Background="#30FF6666" BorderBrush="#60FF6666" BorderThickness="2"
                            IsVisible="{Binding InstallFailed}">
                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Width="56" Height="56" Foreground="#FF6666"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Panel>

                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <!-- Успех -->
                    <TextBlock Text="Установка завершена!" Classes="pageTitle"
                               HorizontalAlignment="Center" IsVisible="{Binding !InstallFailed}"/>
                    <TextBlock TextAlignment="Center" MaxWidth="360" Classes="pageSubtitle"
                               IsVisible="{Binding !InstallFailed}">
                        <Run Text="Revenant Launcher готов к использованию."/>
                        <LineBreak/>
                        <Run Text="Приятной игры!" FontWeight="SemiBold" Foreground="#B388FF"/>
                    </TextBlock>

                    <!-- Ошибка -->
                    <TextBlock Text="Произошла ошибка" Classes="pageTitle"
                               HorizontalAlignment="Center" Foreground="#FF6666"
                               IsVisible="{Binding InstallFailed}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Classes="pageSubtitle"
                               TextAlignment="Center" MaxWidth="380"
                               Foreground="#FFAAAA" IsVisible="{Binding InstallFailed}"/>
                </StackPanel>

            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">

                <Button Classes="successBtn" Click="Launch_Click"
                        IsVisible="{Binding !InstallFailed}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M8 5v14l11-7z" Foreground="White" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Запустить лаунчер" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#66BB6A" Offset="0"/>
                            <GradientStop Color="#4CAF50" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button Classes="secondaryBtn" Click="Finish_Click">
                    <TextBlock Text="Готово" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>