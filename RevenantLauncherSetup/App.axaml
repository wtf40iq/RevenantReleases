<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RevenantLauncherSetup.App"
             xmlns:local="using:RevenantLauncherSetup"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <FontFamily x:Key="MainFont">avares://RevenantLauncherSetup/Assets/Fonts/ofont.ru_Arteks.ttf#Arteks</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://RevenantLauncherSetup/Styles/SetupStyles.axaml"/>
    </Application.Styles>
</Application>