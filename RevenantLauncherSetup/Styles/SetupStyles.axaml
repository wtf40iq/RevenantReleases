<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== БАЗА ===== -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ===== SCROLLBAR ===== -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#60FFFFFF"/>
    </Style>

    <!-- ===== WINDOW CONTROL BUTTONS ===== -->
    <Style Selector="Button.winBtn">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Background" Value="#40000000"/>
        <Setter Property="BorderBrush" Value="#50FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.winBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#60000000"/>
    </Style>
    <Style Selector="Button.winBtnClose">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Background" Value="#40000000"/>
        <Setter Property="BorderBrush" Value="#50FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.winBtnClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#CCFF4444"/>
    </Style>

    <!-- ===== PRIMARY BUTTON (Далее / Установить) ===== -->
    <Style Selector="Button.primaryBtn">
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="23"/>
        <Setter Property="Padding" Value="28,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primaryBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="23"/>
    </Style>
    <Style Selector="Button.primaryBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>
    <Style Selector="Button.primaryBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <Style Selector="Button.primaryBtn:disabled">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ===== SECONDARY BUTTON (Назад / Отмена) ===== -->
    <Style Selector="Button.secondaryBtn">
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="23"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="BorderBrush" Value="#50FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.secondaryBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55FFFFFF"/>
    </Style>
    <Style Selector="Button.secondaryBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>
    <Style Selector="Button.secondaryBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- ===== SUCCESS BUTTON (Запустить лаунчер) ===== -->
    <Style Selector="Button.successBtn">
        <Setter Property="Height" Value="50"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Padding" Value="30,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.successBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="25"/>
    </Style>
    <Style Selector="Button.successBtn:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.04)"/>
    </Style>
    <Style Selector="Button.successBtn:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>

    <!-- ===== BROWSE BUTTON ===== -->
    <Style Selector="Button.browseBtn">
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="BorderBrush" Value="#50FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.browseBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#55FFFFFF"/>
    </Style>

    <!-- ===== TEXTBOX (пути) ===== -->
    <Style Selector="TextBox.pathBox">
        <Setter Property="Background" Value="#40000000"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="#B388FF"/>
        <Setter Property="SelectionBrush" Value="#7C4DFF"/>
    </Style>
    <Style Selector="TextBox.pathBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.pathBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.pathBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.pathBox:focus-within">
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
    </Style>

    <!-- ===== CHECKBOX ===== -->
    <Style Selector="CheckBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="#9E7BFF"/>
        <Setter Property="Background" Value="#207C4DFF"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="#7C4DFF"/>
        <Setter Property="BorderBrush" Value="#7C4DFF"/>
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="White"/>
    </Style>

    <!-- ===== PAGE CONTAINER (плавные переходы) ===== -->
    <Style Selector="Border.page">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- ===== HEADER TEXT ===== -->
    <Style Selector="TextBlock.pageTitle">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="TextBlock.pageSubtitle">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#B0B0B0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <!-- ===== LICENSE TEXTBOX (readonly) ===== -->
    <Style Selector="TextBox.licenseBox">
        <Setter Property="Background" Value="#20000000"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Foreground" Value="#DDDDDD"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AcceptsReturn" Value="True"/>
    </Style>
    <Style Selector="TextBox.licenseBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== INFO BOX (свободное место, требуется) ===== -->
    <Style Selector="Border.infoBox">
        <Setter Property="Background" Value="#207C4DFF"/>
        <Setter Property="BorderBrush" Value="#407C4DFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

        <!-- License TextBox readonly - без подсветки -->
    <Style Selector="TextBox[IsReadOnly=True] /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox[IsReadOnly=True]:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox[IsReadOnly=True]:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</Styles>